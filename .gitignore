# ---- entornos y dependencias, que se reconstruyen ----
venv/
tools/__pycache__/
*.pyc
app/.gradle/
app/build/
app/app/build/
app/local.properties
# codec2 no va en el repo: son decenas de MB y se clona con preparar.sh
app/app/src/main/cpp/codec2/

# ---- binarios compilados ----
firmware/build/
firmware/.pio/
*.apk
*.aab
# ...MENOS los que se publican: la pagina de instalacion los sirve como fichero
# estatico porque el enlace de descarga de un release son tres redirecciones a
# una URL firmada, y el gestor de descargas de Chrome en Android se cuelga con
# eso. Estos SI van en el repositorio a proposito.
!docs/pttlora.apk
!docs/pttlora-v7a.apk

# ---- material de pruebas: se regenera y no aporta historia ----
bench/*.wav
bench/*.mp3
bench/*.raw
bench/salida/
*.log

# ---- configuracion con datos propios ----
# `igate.conf.ejemplo` SI va; el de verdad lleva indicativos y no.
igate.conf
