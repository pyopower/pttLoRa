# igate.conf — pasarela PTT LoRa -> APRS-IS. Ver igate.py.

[reflector]
host = 127.0.0.1
puerto = 4461

[aprs]
# El indicativo con el que ENTRA el igate. No es el de los nodos: es el de la
# pasarela, y conviene que sea un SSID que no uses para otra cosa.
llamada = EA1ABC-14
# `auto` lo calcula del indicativo. No es un secreto: sale del propio
# indicativo y lo unico que afirma es "soy esta estacion".
passcode = auto
# `euro.aprs2.net` y NO `rotate.aprs2.net`: el rotate global reparte por todo el
# mundo y nos mando a T2PANAMA — funcionar funciona, porque APRS-IS replica
# entre servidores, pero es dar la vuelta al planeta para publicar una estacion
# de Andorra. El rotate europeo (T2NUERNBG y compañia) entra por donde toca.
servidor = euro.aprs2.net
puerto = 14580

# Lo unico que ve un desconocido en aprs.fi: dice QUE es y EN QUE frecuencia.
# La frecuencia va la PRIMERA y pegada al `MHz`, que es la convencion de APRS
# para un dato de sintonia: asi aprs.fi la saca como campo propio en vez de
# como texto suelto.
#
# ⚠️ ESTO ES UN PRESUPUESTO DE 43 CARACTERES. APRS garantiza esa longitud de
# comentario y hay clientes que cortan por ahi; el igate avisa en el registro
# si se pasa. Con `nombre` y `bateria` detras, la linea de arriba se queda en
# unos 26. El dia que el proyecto tenga URL publica, cabe asi:
#
#   comentario = 434.400MHz Voice over LoRa pttlora.adan.ovh
#   extras =
#
# ...o quitando solo la bateria (`extras = nombre`) si la URL es corta.
comentario = 434.400MHz Voice over LoRa

# Que se le pega detras: `nombre` del cacharro y/o `bateria`. Vacio = nada.
# La bateria se quito el 8-sep: con ella, `celdaCERRO` se iba a 46 caracteres.
# Y en una celda enchufada a la red el numero no dice nada — sale del divisor
# de tension, que sin bateria mide lo que mide.
# El PAPEL (celda o nodo) no se pone en letra: ya lo dice el simbolo del mapa,
# `#` para un digipetidor y `[` para una persona.
extras = nombre

# ⚠️ `no` = SOLO MIRAR: escribe en el registro lo que publicaria, sin conectar.
# Publicar en APRS-IS NO SE PUEDE DESHACER — aprs.fi guarda el historico para
# siempre—, asi que se mira antes de encender.
enviar = no

# Lista BLANCA: nombre del cacharro (o su src en hexadecimal) -> indicativo
# APRS. A mano y no automatico por dos razones: todos los nodos de un operador
# llevan el mismo indicativo, asi que el SSID es una decision; y un SSID
# inventado pisaria estaciones APRS que ya existan.
# `borroso N` = AMBIGÜEDAD DE POSICION de APRS: se emiten los ultimos digitos en
# blanco y el cliente pinta un circulo de incertidumbre en vez de un punto. No
# es un redondeo nuestro, es parte del formato, y por eso quien lo lee SABE que
# no lo sabe. Niveles: 1 ≈ 185 m, 2 ≈ 1,4 km, 3 ≈ 18 km, 4 = un grado.
#
# NADIE LO USA AHORA MISMO, y es una decision razonada (9-sep): el control de
# privacidad es el INTERRUPTOR de la app —apagas «Posicion» y no sale nada, ni
# al servidor— asi que difuminar encima solo servia para estar en el mapa mal.
# Queda implementado para quien quiera salir sin decir exactamente donde vive.
#
# Y OJO CON DE DONDE SALE CADA POSICION: solo las celdas la llevan tecleada
# (fija, en su NVS). Lo demas la coge del MOVIL por la app, asi que la posicion
# de un nodo cliente es la de la PERSONA que lo lleva, no la de un cacharro —
# de ahi que se difumine. Sin movil delante, esos nodos no publican nada.
# Se busca por NOMBRE del cacharro (lo que viaja en las balizas), por
# INDICATIVO de quien habla (lo que viaja en las transmisiones) y por src en
# hexadecimal, en ese orden. Hacen falta los dos primeros porque son cosas
# distintas: una CELDA se publica como cacharro —es un sitio— y una PERSONA se
# publica como persona, desde donde quiera que hable.
[nodos]
# la celda, por nombre: es infraestructura y baliza su posicion ella sola
celdaCERRO = EA1ABC-11
# la persona, por indicativo: su posicion sale en el INICIO de cada transmision
EA1ABC      = EA1ABC-9
