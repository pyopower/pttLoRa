# Configuracion de ESP-IDF del entorno `transceptor` (Arduino como componente).
# Los demas entornos son Arduino a secas y no la leen. Sale de bench/hfp-ag.
# ⚠️ Si se toca, borrar sdkconfig.transceptor.
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="particiones.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# --- Bluetooth: la placa como PASARELA de manos libres (HFP-AG) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
# Sin BLE: el transceptor no habla con la app, y la RAM es lo que escasea.
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=n
# EL CANAL DE AUDIO. El core de Arduino trae 0 conexiones SCO y el audio por
# PCM (patillas): aqui 1 conexion y el audio por HCI, o sea, al firmware.
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
# CVSD a 8 kHz, lo que come Codec2. mSBC (16 kHz) obligaria a remuestrear.
CONFIG_BT_HFP_WBS_ENABLE=n
CONFIG_BT_SSP_ENABLED=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32_WIFI_SW_COEXIST_ENABLE=y
# --- RAM: WiFi + Bluetooth Classic + Codec2 no caben con los valores por defecto ---
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP32_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP32_WIFI_RX_BA_WIN=0
CONFIG_ESP32_WIFI_IRAM_OPT=n
CONFIG_ESP32_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2920
CONFIG_LWIP_TCP_WND_DEFAULT=2920
# --- Registro: SOLO errores. Los INFO de ESP-IDF (WiFi, GPIO a cada analogRead)
# salen por la MISMA UART que el KISS del nodo y ensucian las tramas: el
# Arduino precompilado de los demas entornos no saca nada. ---
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_DEFAULT_LEVEL=1
# --- Vigilante de tareas como en Arduino a secas ---
# loop() no suelta nunca la CPU 1 (en Arduino nadie lo espera), y con el valor
# de ESP-IDF el vigilante mira la tarea de reposo de esa CPU: si loop() pasa
# 5 s sin bloquearse en ningún sitio, la placa se reinicia. Pasó en nodoCASA el
# 2-oct-2026 a los 276 s de arrancar, en reposo («reset=wdt-tarea»).
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# --- A2DP + AVRCP, solo para el PTT del Abbree (3-oct-2026) ---
# El Abbree manda su PTT por AVRCP (FF/REWIND) y solo abre AVRCP tras A2DP: la
# placa se registra como fuente A2DP sin llegar a mandar musica nunca.
CONFIG_BT_A2DP_ENABLE=y
